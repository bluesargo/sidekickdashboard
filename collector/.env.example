# Where to push snapshots (your deployed Next.js app).
DASHBOARD_URL=https://your-app.vercel.app
# Must match INGEST_TOKEN on the server.
INGEST_TOKEN=

# Poll interval in seconds (default 300 = 5 min). The reTerminal refreshes slowly,
# so there's no need to poll faster than the device.
POLL_SECONDS=300

# ---- Claude ----
# Override the Claude data dir (default: ~/.claude).
# CLAUDE_DIR=
# Spend caps used to turn rolling cost into a % gauge. Tune to your plan.
# Leave unset to report cost only (session_pct/weekly_pct will be null).
CLAUDE_SESSION_CAP_USD=
CLAUDE_WEEKLY_CAP_USD=

# ---- Codex (best effort, local logs) ----
# CODEX_DIR=            # default: ~/.codex

# ---- Cursor (optional, via API) ----
# Admin API key from the Cursor dashboard. If set, the collector fetches usage.
# CURSOR_API_KEY=

# ---- Manual fallbacks (optional) ----
# If set, these are pushed every cycle (handy if you don't want to use /admin).
# LOVABLE_CREDITS=
# REPLIT_BALANCE_USD=
