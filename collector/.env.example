# Where to push snapshots (your deployed Next.js app).
DASHBOARD_URL=https://your-app.vercel.app
# Must match INGEST_TOKEN on the server.
INGEST_TOKEN=

# Poll interval in seconds (default 300 = 5 min). The reTerminal refreshes slowly,
# so there's no need to poll faster than the device.
POLL_SECONDS=300

# ---- Claude ----
# Real session/weekly % come from the OAuth token in ~/.claude/.credentials.json
# (Claude Code login) — nothing to set if you use Claude Code.
# CLAUDE_DIR=                 # override Claude data dir (default: ~/.claude)
# CLAUDE_OAUTH_TOKEN=         # paste a token instead of reading the creds file
# Fallback only — used when no OAuth token is found (API-key auth). Turns rolling
# JSONL spend into a % gauge. Leave unset to report USD spend instead.
CLAUDE_SESSION_CAP_USD=
CLAUDE_WEEKLY_CAP_USD=

# ---- Codex ----
# Real session/weekly % are read from ~/.codex/sessions rollout files. No auth.
# CODEX_DIR=            # default: ~/.codex

# ---- Cursor (optional, via API) ----
# Admin API key from the Cursor dashboard. If set, the collector fetches usage.
# CURSOR_API_KEY=

# ---- Manual fallbacks (optional) ----
# If set, these are pushed every cycle (handy if you don't want to use /admin).
# LOVABLE_CREDITS=
# REPLIT_BALANCE_USD=
