# ---- Supabase (server-side only) ----
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Service-role key. NEVER expose to the browser or to SenseCraft. Used by ingest/manual routes.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth tokens ----
# Shared secret the local collector sends (Authorization: Bearer <INGEST_TOKEN>) to POST /api/ingest.
INGEST_TOKEN=
# Token required to read the dashboard JSON from the device (passed as ?key= or X-Api-Key header).
# This is the value you paste into SenseCraft HMI's data-source auth. Keep it private-ish.
DASHBOARD_READ_TOKEN=
# Password for the /admin manual-entry page (sent as X-Admin-Token).
ADMIN_TOKEN=
